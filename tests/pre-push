#!/usr/bin/env bash
# Sura-agentic pre-push: jalankan semua test sebelum push.
# Pasang: ln -sf ../../tests/pre-push .git/hooks/pre-push   |   Lewati darurat: git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"
echo "🧪 pre-push: menjalankan test Sura-agentic..."
if ! bash tests/test-content.sh || ! bash tests/test-hooks.sh || ! bash tests/test-plugin.sh || ! bash tests/test-install.sh || ! bash tests/measure.sh --check; then
  echo "❌ Test gagal — push dibatalkan. Perbaiki dulu, atau paksa dengan: git push --no-verify"
  exit 1
fi
